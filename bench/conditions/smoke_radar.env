# Smoke check of the RADAR harness (job_smoke.sh forces SMOKE=1).
PLATFORM=radar
WRITES_ONLY=1
BENCH_EXCLUSIVE=1
BENCH_CPUS=128
BENCH_MEM=32G
BATCH_TIMEOUT=60
LOCUST_TIMEOUT=60
LOAD_MODE=open
DEVICE_RATE_HZ=1
# the values below are overridden by SMOKE=1 but must exist for the checks
SIZES=100,1000
# latency requests paced at this rate (both platforms; keeps MEDWEAR's per-user limit out)
LATENCY_RATE_HZ=2
ITERATIONS=2
USERS=2
SPAWN_RATE=2
# open loop: arrivals beyond this many requests in flight are dropped (counted as failures)
MAX_INFLIGHT=2000
STAGE_SECONDS=30
STAGE_ISOLATION=drain
DRAIN_SECONDS=5
DUR_REPS=1
# durability writer pace (batches/s), same on both platforms
DUR_RATE_HZ=2
DUR_WRITE_SECONDS=20
RADAR_TOPIC=bench_samples
RADAR_TOPIC_PARTITIONS=3
