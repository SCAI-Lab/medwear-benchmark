# SECONDARY (parameter change). MEDWEAR a8a666b as deployed EXCEPT BATCH_RATE_LIMIT raised so the
# per-user limit (all simulated devices share one bench user) does not cap the load. Report as
# "MEDWEAR a8a666b with BATCH_RATE_LIMIT=1000000/minute".
PLATFORM=medwear
BENCH_PROJECT=medwear_benchmark
# recorded only: MEDWEAR a8a666b uses the default pool (5 + 10 overflow); checked inside the API
DB_POOL_SIZE=5
UVICORN_WORKERS=1
MEDWEAR_SRC_REV=a8a666b
# raised from the deployed default 300/minute
BATCH_RATE_LIMIT=1000000/minute
# resources per job: exclusive node (--exclusive), all 128 cores; memory limit 32 GB
BENCH_EXCLUSIVE=1
BENCH_CPUS=128
BENCH_MEM=32G
WRITES_ONLY=1
# client timeouts (s); passed to the HTTP client, slower responses count as timeouts
BATCH_TIMEOUT=600
LOCUST_TIMEOUT=60
# latency: every platform as deployed (MEDWEAR also directly at the API)
SIZES=100,500,1000,5000,10000,50000
# latency requests paced at this rate (both platforms; keeps MEDWEAR's per-user limit out)
LATENCY_RATE_HZ=2
ITERATIONS=30
# load: levels = simulated devices
USERS="10 50 100 200"
SPAWN_RATE=10
# open loop: arrivals beyond this many requests in flight are dropped (counted as failures)
MAX_INFLIGHT=2000
STAGE_SECONDS=600
STAGE_ISOLATION=fresh
# durability: n >= 5 per (target, fault)
DUR_REPS=5
# durability writer pace (batches/s), same on both platforms
DUR_RATE_HZ=2
DUR_WRITE_SECONDS=40
LOAD_MODE=open
DEVICE_RATE_HZ=1
