# Smoke run for MEDWEAR 49be39f with sessions (see medwear_sessions_*.env).
# Smoke check of the MEDWEAR harness (job_smoke.sh forces SMOKE=1).
PLATFORM=medwear
WRITES_ONLY=1
BENCH_EXCLUSIVE=1
BENCH_CPUS=128
BENCH_MEM=32G
BATCH_TIMEOUT=60
LOCUST_TIMEOUT=60
BENCH_PROJECT=medwear_benchmark
# recorded only: MEDWEAR 49be39f uses the default pool (5 + 10 overflow); checked inside the API
DB_POOL_SIZE=5
UVICORN_WORKERS=1
MEDWEAR_SRC_REV=49be39f
# deployed default per-user limit on POST /v1/data/batch
BATCH_RATE_LIMIT=300/minute
LOAD_MODE=open
DEVICE_RATE_HZ=1
# the values below are overridden by SMOKE=1 but must exist for the checks
SIZES=100,1000
# latency requests paced at this rate (both platforms; keeps MEDWEAR's per-user limit out)
LATENCY_RATE_HZ=2
ITERATIONS=2
USERS=2
SPAWN_RATE=2
# open loop: arrivals beyond this many requests in flight are dropped (counted as failures)
MAX_INFLIGHT=2000
STAGE_SECONDS=30
STAGE_ISOLATION=drain
DRAIN_SECONDS=5
DUR_REPS=1
# durability writer pace (batches/s), same on both platforms
DUR_RATE_HZ=2
DUR_WRITE_SECONDS=20
MEDWEAR_SESSIONS=1
