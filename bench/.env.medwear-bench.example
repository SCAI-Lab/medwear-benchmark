# Keys of bench/.env.medwear-bench (generate the real file with bench/make_bench_env.sh).
POSTGRES_USER=medwear
POSTGRES_PASSWORD=<random>
POSTGRES_DB=postgres
POSTGRES_HOST=medwear-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://medwear:<pg password>@medwear-postgres:5432/medwear_benchmark
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=bench
DOCKER_INFLUXDB_INIT_PASSWORD=<random>
DOCKER_INFLUXDB_INIT_ORG=medwear
DOCKER_INFLUXDB_INIT_BUCKET=medwear_bench
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=<random>
INFLUX_URL=http://medwear-influxdb:8086
INFLUX_TOKEN=<same as DOCKER_INFLUXDB_INIT_ADMIN_TOKEN>
INFLUX_ORG=medwear
INFLUX_BUCKET=medwear_bench
MINIO_ROOT_USER=benchroot
MINIO_ROOT_PASSWORD=<random>
MINIO_API_ACCESS_KEY=benchapi
MINIO_API_SECRET_KEY=<random>
MINIO_ENDPOINT=medwear-minio:9000
KEYCLOAK_ADMIN=benchadmin
KEYCLOAK_ADMIN_PASSWORD=<random>
KEYCLOAK_URL=http://medwear-keycloak:8080
KEYCLOAK_REALM=medwear
KEYCLOAK_CLIENT_ID=med-api
KEYCLOAK_CLIENT_SECRET=<random; ingest only verifies JWTs>
KC_DB_USERNAME=medwear
KC_DB_PASSWORD=<same as POSTGRES_PASSWORD>
DEVICE_API_KEYS=
SERVER_HOST=localhost
SERVER_IP=127.0.0.1
